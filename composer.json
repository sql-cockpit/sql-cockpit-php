{
    "name": "sql-cockpit/sdk",
    "description": "The official PHP client for the SQL Cockpit portal API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sql-cockpit", "sdk", "api", "client", "psr-18"],
    "homepage": "https://github.com/sql-cockpit/sql-cockpit-php",
    "authors": [
        {
            "name": "SQL Cockpit",
            "homepage": "https://sql-cockpit.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "suggest": {
        "ext-curl": "Used by the built-in transport when no PSR-18 client is installed."
    },
    "autoload": {
        "psr-4": {
            "SqlCockpit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SqlCockpit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable"
}
